@{
    ViewData["Title"] = "Add New Department";
}

@model Department?

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Add New Department</h4>
                </div>
                <div class="card-body">
                    <form action="/Department/Create" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="All"></div>

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label">DeptName</label>
                            <input asp-for="Name" class="form form-control" placeholder="Enter dept name" required />
                            <span asp-validation-for="Name" style="color:red"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Location" class="form-label">DeptLocation</label>
                            <input asp-for="Location" class="form-control" placeholder="Enter dept location" required />
                            <span asp-validation-for="Location" style="color:red"></span>

                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="GetDepartments" 
                               asp-controller="Department" 
                               asp-route-id="3"
                               asp-route-name="ahmedatef">
                               Back2Depts
                           </a>

                            <button type="submit" class="btn btn-success">Save</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

