@{
    ViewData["Title"] = "Add New Department";
}

@model Department?

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Add New Department</h4>
                </div>
                <div class="card-body">
                    <form action="/Department/Create" method="post">
                        @* <div class="mb-3">
                            <label for="did" class="form-label">Department ID</label>
                            <input type="text" id="did" name="did" class="form-control" placeholder="Enter department ID" />
                        </div> *@

                        <div class="mb-3">
                            <label for="name" class="form-label">Department Name</label>
                            <input type="text" id="name" name="name" value="@Model?.Name" class="form-control" placeholder="Enter department name" required />
                        </div>

                        <div class="mb-3">
                            <label for="location" class="form-label">Location</label>
                            <input type="text" id="location" name="location" value="@Model?.Location" class="form-control" placeholder="Enter location" required />
                        </div>

                        <div class="d-flex justify-content-between">
                            <a href="/Department/Index" class="btn btn-secondary">Back to All Departments</a>
                            <button type="submit" class="btn btn-success">Save</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>