@model List<Department>

@{
    ViewData["Title"] = "All Departments";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>All Departments</h2>
        <!-- Anchor tag pointing to Create Department action | GET -->
        <a href="/Department/Create" class="btn btn-primary">+ Add New Department</a> 
    </div>

    <table class="table table-bordered table-hover">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Department Name</th>
                <th>Location</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Count > 0)
            {
                foreach (var dept in Model)
                {
                    <tr>
                        <td>@dept.Did</td>
                        <td>@dept.Name</td>
                        <td>@dept.Location</td>
                        <td>
                            <a href="/Department/Edit/@dept.Did" class="btn btn-sm btn-warning">Edit</a>
                            <a href="/Department/Delete/@dept.Did" class="btn btn-sm btn-danger">Delete</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="4" class="text-center text-muted">No departments found.</td>
                </tr>
            }
        </tbody>
    </table>
</div>